{
  "name": "web",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "verify:docs": "bun scripts/verify-docs.ts",
    "gen:ir": "bun scripts/gen-docs-ir.ts && bun scripts/gen-playground-ir.ts",
    "gen:llms": "bun scripts/gen-llms.ts",
    "gen:seo": "bun scripts/gen-seo.ts",
    "gen": "bun run gen:ir && bun run gen:llms && bun run gen:seo",
    "check:encoding": "bun scripts/fix-encoding.ts --check"
  },
  "devDependencies": {
    "happy-dom": "^20.14.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.7",
    "typescript": "^6.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
