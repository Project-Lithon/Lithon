def get_max(a:int[8],b:int[8]) -> int[16]:
	if (a > b):
		print(f"Delta is |a-b|: {a-b}")
		return a
	else:
		print(f"Delta is |b-a|: {b-a}")
		return b


a:int[8] = int(8,input("Enter value 1: "))
b:int[8] = int(8,input("Enter value 2: "))
print(f"Larger value between {a} and {b} is: {get_max(a,b)}")
