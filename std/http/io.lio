        if off + 15 < nreq:
            ch.f15 = req[off + 15]
        if off + 16 < nreq:
            ch.f16 = req[off + 16]
        if off + 17 < nreq:
            ch.f17 = req[off + 17]
        if off + 18 < nreq:
            ch.f18 = req[off + 18]
        if off + 19 < nreq:
            ch.f19 = req[off + 19]
        if off + 20 < nreq:
            ch.f20 = req[off + 20]
        if off + 21 < nreq:
            ch.f21 = req[off + 21]
        if off + 22 < nreq:
            ch.f22 = req[off + 22]
        if off + 23 < nreq:
            ch.f23 = req[off + 23]
        if off + 24 < nreq:
            ch.f24 = req[off + 24]
        if off + 25 < nreq:
            ch.f25 = req[off + 25]
        if off + 26 < nreq:
            ch.f26 = req[off + 26]
        if off + 27 < nreq:
            ch.f27 = req[off + 27]
        if off + 28 < nreq:
            ch.f28 = req[off + 28]
        if off + 29 < nreq:
            ch.f29 = req[off + 29]
        if off + 30 < nreq:
            ch.f30 = req[off + 30]
        if off + 31 < nreq:
            ch.f31 = req[off + 31]
        if off + 32 < nreq:
            ch.f32 = req[off + 32]
        if off + 33 < nreq:
            ch.f33 = req[off + 33]
        if off + 34 < nreq:
            ch.f34 = req[off + 34]
        if off + 35 < nreq:
            ch.f35 = req[off + 35]
        if off + 36 < nreq:
            ch.f36 = req[off + 36]
        if off + 37 < nreq:
            ch.f37 = req[off + 37]
        if off + 38 < nreq:
            ch.f38 = req[off + 38]
        if off + 39 < nreq:
            ch.f39 = req[off + 39]
        if off + 40 < nreq:
            ch.f40 = req[off + 40]
        if off + 41 < nreq:
            ch.f41 = req[off + 41]
        if off + 42 < nreq:
            ch.f42 = req[off + 42]
        if off + 43 < nreq:
            ch.f43 = req[off + 43]
