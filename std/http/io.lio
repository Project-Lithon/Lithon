# std/http/io.lio -- the byte path between a bounded string and the kernel.
#
# Every kernel read and write goes through a 64-byte `Chunk` struct, because a
# struct is the only buffer whose address the kernel can use in both tiers.
# The two copy blocks below move the bytes between the chunk and a bounded
# string, one field at a time; `tools/gen_http_net.py` writes them and keeps
# them in step with the markers.
#
# Failures come back as text that starts with "LITHON-HTTP-ERROR[n]: ", so a
# caller that only has a string still sees the failure (see net.lio for the
# code table). Sockets are plain IPv4 or IPv6 stream sockets.

import std.http.core
import std.http.response

from std.http.core import Chunk, SockAddr, Sock6, Timeval, swap16, swap32

# The length argument of getsockname(2): a 4-byte socklen_t in its own struct,
# so the kernel writes through a real address in both tiers.
class Socklen(struct):
    n: int[32]


# Set SO_RCVTIMEO and SO_SNDTIMEO. The send timeout also bounds connect(2) on
# Linux, so one call covers the whole exchange. 0 means no timeout.
def set_timeouts(fd: int[64], timeout_ms: int[64]) -> int[64]:
    tv: Timeval
    tv.sec = int(64, timeout_ms / 1000.0)
    tv.usec = int(64, (timeout_ms % 1000) / 1.0) * 1000
    if timeout_ms <= 0:
        tv.sec = 0
        tv.usec = 0
    r: int[64] = syscall(54, fd, 1, 20, addressof(tv), 16, 0)
    if r < 0:
        return r
    return syscall(54, fd, 1, 21, addressof(tv), 16, 0)


# A connected IPv4 stream socket to ip:port, or a negative errno.
def connect4(ip: int[64], port: int[64], timeout_ms: int[64]) -> int[64]:
    fd: int[64] = syscall(41, 2, 1, 0, 0, 0, 0)
    if fd < 0:
        return fd
    set_timeouts(fd, timeout_ms)
    sa: SockAddr
    sa.lo = 2 | (swap16(port) << 16) | (swap32(ip) << 32)
    sa.hi = 0
    r: int[64] = syscall(42, fd, addressof(sa), 16, 0, 0, 0)
    if r < 0:
        syscall(3, fd, 0, 0, 0, 0, 0)
        return r
    # A TCP connect can make the socket connect to itself: when the ephemeral
    # source port equals the target port and nothing listens there, the socket
    # reads back its own request. The local address then equals the peer.
    me: SockAddr
    ml: Socklen
    ml.n = 16
    g: int[64] = syscall(51, fd, addressof(me), addressof(ml), 0, 0, 0)
    if g < 0:
        syscall(3, fd, 0, 0, 0, 0, 0)
        return g
    if me.lo == sa.lo and me.hi == sa.hi:
        syscall(3, fd, 0, 0, 0, 0, 0)
        return -111
    return fd


# A connected IPv6 stream socket. `addr` holds 16 address bytes (indices 0-15);
# byte 16 is unused here.
def connect6(addr: str[17], port: int[64], timeout_ms: int[64]) -> int[64]:
    fd: int[64] = syscall(41, 10, 1, 0, 0, 0, 0)
    if fd < 0:
        return fd
    set_timeouts(fd, timeout_ms)
    s: Sock6
    s.w0 = 10 | (swap16(port) << 16)
    s.w1 = 0
    s.w2 = addr_word(addr, 0)
    s.w3 = addr_word(addr, 4)
    s.w4 = addr_word(addr, 8)
    s.w5 = addr_word(addr, 12)
    s.w6 = 0
    r: int[64] = syscall(42, fd, addressof(s), 28, 0, 0, 0)
    if r < 0:
        syscall(3, fd, 0, 0, 0, 0, 0)
        return r
    return fd


# A connected IPv6 stream socket to eight 16-bit address groups g0..g7, in
# order, as ip6.lio produces them. Packs the sockaddr with swapped groups so
# that the kernel reads them back in network order.
def connect6_groups(g0: int[64], g1: int[64], g2: int[64], g3: int[64], g4: int[64], g5: int[64], g6: int[64], g7: int[64], port: int[64], timeout_ms: int[64]) -> int[64]:
    fd: int[64] = syscall(41, 10, 1, 0, 0, 0, 0)
    if fd < 0:
        return fd
    set_timeouts(fd, timeout_ms)
    s: Sock6
    s.w0 = 10 | (swap16(port) << 16)
    s.w1 = 0
    s.w2 = swap16(g0) | (swap16(g1) << 16)
    s.w3 = swap16(g2) | (swap16(g3) << 16)
    s.w4 = swap16(g4) | (swap16(g5) << 16)
    s.w5 = swap16(g6) | (swap16(g7) << 16)
    s.w6 = 0
    r: int[64] = syscall(42, fd, addressof(s), 28, 0, 0, 0)
    if r < 0:
        syscall(3, fd, 0, 0, 0, 0, 0)
        return r
    return fd


# Four address bytes starting at `at`, packed little-endian into one word, so
# that the kernel reads them back in network order.
def addr_word(addr: str[17], at: int[64]) -> int[64]:
    w: int[64] = 0
    k: int[64] = 3
    while k >= 0:
        w = (w << 8) | (addr[at + k] & 255)
        k = k - 1
    return ((w & 255) << 24) | (((w >> 8) & 255) << 16) | (((w >> 16) & 255) << 8) | ((w >> 24) & 255)


def close_fd(fd: int[64]) -> int[64]:
    return syscall(3, fd, 0, 0, 0, 0, 0)


# Send the first `nreq` bytes of `req`, looping over short writes. Returns 0,
# or a negative errno.
def send_all(fd: int[64], req: str[4096], nreq: int[64]) -> int[64]:
    ch: Chunk
    off: int[64] = 0
    while off < nreq:
#<<COPY_IN>>
        if off + 0 < nreq:
            ch.f0 = req[off + 0]
        if off + 1 < nreq:
            ch.f1 = req[off + 1]
        if off + 2 < nreq:
            ch.f2 = req[off + 2]
        if off + 3 < nreq:
            ch.f3 = req[off + 3]
