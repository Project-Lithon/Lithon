            ch.f60 = req[off + 60]
        if off + 61 < nreq:
            ch.f61 = req[off + 61]
        if off + 62 < nreq:
            ch.f62 = req[off + 62]
        if off + 63 < nreq:
            ch.f63 = req[off + 63]
#<</COPY_IN>>
        remain: int[64] = nreq - off
        if remain > 64:
            remain = 64
        sent: int[64] = syscall(44, fd, addressof(ch), remain, 0, 0, 0)
        if sent < 0:
            return sent
        if sent == 0:
            return -32
        off = off + sent
    return 0


# Whether `resp`, holding `total` bytes, is one whole HTTP message, by mode:
# 1 a reply, 2 a HEAD reply, 3 a request. The header block must have ended.
# A HEAD reply, a 1xx, a 204 and a 304 end there, and so does a request with
# no Content-Length (it has no body). Otherwise a Content-Length body ends at
# that many bytes, and a chunked reply ends at its last-chunk line "0\r\n\r\n"
# at a chunk boundary. A chunk whose data itself contains "\r\n0\r\n\r\n" ends
# early; the decoder then reports error 11. A reply with no framing waits for
# EOF. A chunked request body is not supported.
def frame_done(resp: str[8192], total: int[64], mode: int[64]) -> bool:
    head: int[64] = resp.find("\r\n\r\n")
    if head < 0:
        return False
    body: int[64] = head + 4
    if mode == 2:
        return True
    if mode == 1:
        code: int[64] = std.http.response.resp_status(resp)
        if code < 200 or code == 204:
            return True
        if code == 304:
            return True
    cl: str[512] = std.http.response.resp_header(resp, "Content-Length")
    if len(cl) > 0:
        if len(cl) > 9:
            return True
        want: int[64] = 0
        i: int[64] = 0
        while i < len(cl):
            d: int[64] = cl[i]
            if d < 48 or d > 57:
                return True
            want = want * 10 + (d - 48)
            i = i + 1
        return total >= body + want
    if mode == 3:
        return True
    te: str[512] = std.http.response.resp_header(resp, "Transfer-Encoding")
    if te.find("chunked") < 0:
        return False
    if total < body + 5:
        return False
    last: str[8] = "0\r\n\r\n"
    e: int[64] = total - 5
    k: int[64] = 0
    while k < 5:
        if resp[e + k] != last[k]:
            return False
        k = k + 1
    if e == body:
        return True
    if e < body + 2:
        return False
    if resp[e - 2] != 13:
        return False
    return resp[e - 1] == 10


# Read one message from `fd`. Mode 0 reads until the peer closes (DNS). Mode 1
# reads one HTTP reply and stops where frame_done says it ends; mode 2 is the
# same for a HEAD reply. A failure comes back as a LITHON-HTTP-ERROR diagnostic:
# a timeout, another recv error, more data than the 8 KiB buffer holds, or (HTTP
# modes) a connection closed before any reply.
def recv_all(fd: int[64], mode: int[64]) -> str[8192]:
    resp: str[8192] = ""
    ch: Chunk
    total: int[64] = 0
    while True:
        n: int[64] = syscall(45, fd, addressof(ch), 64, 0, 0, 0)
        if n == 0:
            if mode != 0 and total == 0:
                return "LITHON-HTTP-ERROR[6]: the connection closed before a complete message"
            break
        if n < 0:
            if n == -11 or n == -110:
                return "LITHON-HTTP-ERROR[5]: the read timed out"
            return "LITHON-HTTP-ERROR[6]: recv() failed"
        if total + n > 8191:
            return "LITHON-HTTP-ERROR[10]: the response is larger than the 8 KiB buffer"
        cpy: int[64] = 0
        while cpy < n:
#<<COPY_OUT>>
            if cpy == 0:
                resp[total + 0] = ch.f0
            if cpy == 1:
                resp[total + 1] = ch.f1
            if cpy == 2:
                resp[total + 2] = ch.f2
            if cpy == 3:
                resp[total + 3] = ch.f3
            if cpy == 4:
                resp[total + 4] = ch.f4
            if cpy == 5:
                resp[total + 5] = ch.f5
            if cpy == 6:
                resp[total + 6] = ch.f6
            if cpy == 7:
                resp[total + 7] = ch.f7
            if cpy == 8:
                resp[total + 8] = ch.f8
            if cpy == 9:
                resp[total + 9] = ch.f9
            if cpy == 10:
                resp[total + 10] = ch.f10
            if cpy == 11:
                resp[total + 11] = ch.f11
