            ch.f5 = req[off + 5]
        if off + 6 < nreq:
            ch.f6 = req[off + 6]
        if off + 7 < nreq:
            ch.f7 = req[off + 7]
        if off + 8 < nreq:
            ch.f8 = req[off + 8]
        if off + 9 < nreq:
            ch.f9 = req[off + 9]
        if off + 10 < nreq:
            ch.f10 = req[off + 10]
        if off + 11 < nreq:
            ch.f11 = req[off + 11]
        if off + 12 < nreq:
            ch.f12 = req[off + 12]
        if off + 13 < nreq:
            ch.f13 = req[off + 13]
        if off + 14 < nreq:
