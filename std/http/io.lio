            ch.f44 = req[off + 44]
        if off + 45 < nreq:
            ch.f45 = req[off + 45]
        if off + 46 < nreq:
            ch.f46 = req[off + 46]
        if off + 47 < nreq:
            ch.f47 = req[off + 47]
        if off + 48 < nreq:
            ch.f48 = req[off + 48]
        if off + 49 < nreq:
            ch.f49 = req[off + 49]
        if off + 50 < nreq:
            ch.f50 = req[off + 50]
        if off + 51 < nreq:
            ch.f51 = req[off + 51]
        if off + 52 < nreq:
            ch.f52 = req[off + 52]
        if off + 53 < nreq:
            ch.f53 = req[off + 53]
        if off + 54 < nreq:
            ch.f54 = req[off + 54]
        if off + 55 < nreq:
            ch.f55 = req[off + 55]
        if off + 56 < nreq:
            ch.f56 = req[off + 56]
        if off + 57 < nreq:
            ch.f57 = req[off + 57]
        if off + 58 < nreq:
            ch.f58 = req[off + 58]
