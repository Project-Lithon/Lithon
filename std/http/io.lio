            if cpy == 21:
                resp[total + 21] = ch.f21
            if cpy == 22:
                resp[total + 22] = ch.f22
            if cpy == 23:
                resp[total + 23] = ch.f23
            if cpy == 24:
                resp[total + 24] = ch.f24
            if cpy == 25:
                resp[total + 25] = ch.f25
            if cpy == 26:
                resp[total + 26] = ch.f26
            if cpy == 27:
                resp[total + 27] = ch.f27
            if cpy == 28:
                resp[total + 28] = ch.f28
            if cpy == 29:
                resp[total + 29] = ch.f29
            if cpy == 30:
                resp[total + 30] = ch.f30
            if cpy == 31:
                resp[total + 31] = ch.f31
            if cpy == 32:
                resp[total + 32] = ch.f32
            if cpy == 33:
                resp[total + 33] = ch.f33
            if cpy == 34:
                resp[total + 34] = ch.f34
            if cpy == 35:
                resp[total + 35] = ch.f35
            if cpy == 36:
                resp[total + 36] = ch.f36
            if cpy == 37:
                resp[total + 37] = ch.f37
            if cpy == 38:
                resp[total + 38] = ch.f38
            if cpy == 39:
                resp[total + 39] = ch.f39
            if cpy == 40:
                resp[total + 40] = ch.f40
            if cpy == 41:
                resp[total + 41] = ch.f41
            if cpy == 42:
                resp[total + 42] = ch.f42
            if cpy == 43:
                resp[total + 43] = ch.f43
            if cpy == 44:
                resp[total + 44] = ch.f44
            if cpy == 45:
                resp[total + 45] = ch.f45
            if cpy == 46:
                resp[total + 46] = ch.f46
            if cpy == 47:
                resp[total + 47] = ch.f47
            if cpy == 48:
                resp[total + 48] = ch.f48
            if cpy == 49:
                resp[total + 49] = ch.f49
            if cpy == 50:
                resp[total + 50] = ch.f50
            if cpy == 51:
                resp[total + 51] = ch.f51
            if cpy == 52:
                resp[total + 52] = ch.f52
            if cpy == 53:
                resp[total + 53] = ch.f53
            if cpy == 54:
                resp[total + 54] = ch.f54
            if cpy == 55:
                resp[total + 55] = ch.f55
            if cpy == 56:
                resp[total + 56] = ch.f56
            if cpy == 57:
                resp[total + 57] = ch.f57
            if cpy == 58:
                resp[total + 58] = ch.f58
            if cpy == 59:
                resp[total + 59] = ch.f59
            if cpy == 60:
                resp[total + 60] = ch.f60
            if cpy == 61:
                resp[total + 61] = ch.f61
            if cpy == 62:
                resp[total + 62] = ch.f62
            if cpy == 63:
                resp[total + 63] = ch.f63
#<</COPY_OUT>>
            cpy = cpy + 1
        total = total + n
        if mode != 0 and frame_done(resp, total, mode):
            break
    return resp
