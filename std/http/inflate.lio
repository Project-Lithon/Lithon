# std/http/inflate.lio -- Content-Encoding: gzip, x-gzip and deflate.
#
# decode_content takes the RAW response (status line, headers, body) and
# returns it with a gzip or zlib body replaced by its decoded bytes. The
# Content-Encoding and Content-Length headers are removed, because the body the
# caller now sees is no longer the coded one. Every other header is kept as
# the server sent it.
#
# The decoder reads the coded body by index. A str's len() stops at a NUL byte,
# but indexing does not, and compressed data is full of NULs, so the body is
# never measured. A stream ends at its final block, and the CRC-32 (gzip) or
# Adler-32 (zlib) check plus the decoded size catches a truncated or corrupt
# body. The decoded body is a str again, so a decoded body containing NUL bytes
# is cut at the first one by len(), exactly like any other str body.
#
# Errors come back as text "LITHON-HTTP-ERROR[n]: ...": 10 when the decoded
# body would not fit in 8 KiB, 12 when the coding is unknown or the data is
# malformed. Chunked framing combined with a content coding is error 12 too:
# it is not supported yet.
#
# The 256-entry byte table `tbl` is written by tools/gen_inflate_table.py
# between the markers below. A str element cannot take an int[64] value
# directly, so decoded literals are looked up in the table instead.

import std.http.response
from std.http.chunked import without_headers


# The text of an unsupported or malformed coding.
def bad_coding() -> str[8192]:
    return "LITHON-HTTP-ERROR[12]"


# Whether v equals `want`, ignoring ASCII case. `want` is lowercase.
def same_ci(v: str[512], want: str[16]) -> bool:
    if len(v) != len(want):
        return False
    i: int[64] = 0
    while i < len(want):
        a: int[64] = v[i]
        if a >= 65 and a <= 90:
            a = a + 32
        b: int[64] = want[i]
        if a != b:
            return False
        i = i + 1
    return True


# The raw response with its coded body decoded. A response with no
# Content-Encoding, or with "identity", comes back unchanged.
def decode_content(resp: str[8192]) -> str[8192]:
    ce: str[512] = std.http.response.resp_header(resp, "Content-Encoding")
    if len(ce) == 0 or same_ci(ce, "identity"):
        return resp
    is_gz: bool = same_ci(ce, "gzip") or same_ci(ce, "x-gzip")
    if not (is_gz or same_ci(ce, "deflate")):
        return "LITHON-HTTP-ERROR[12]: unsupported Content-Encoding"
    te: str[512] = std.http.response.resp_header(resp, "Transfer-Encoding")
    if len(te) != 0:
        return "LITHON-HTTP-ERROR[12]: Content-Encoding with chunked framing is not supported"
    head: int[64] = resp.find("\r\n\r\n")
    if head < 0:
        return resp
    decoded: str[8192] = inflate_body(resp, head + 4)
    if decoded.find("LITHON-HTTP-ERROR[12]") == 0:
        return "LITHON-HTTP-ERROR[12]: malformed or unsupported gzip or deflate body"
    if decoded.find("LITHON-HTTP-ERROR[") == 0:
        return decoded
    return without_headers(resp, decoded, "content-encoding:", "content-length:")


# The decoded bytes of the coded body that starts at byte `start` of `src`: a
# gzip member (RFC 1952) or a zlib stream (RFC 1950) around a DEFLATE stream
# (RFC 1951). Only the first member is decoded; bytes after it are ignored.
def inflate_body(src: str[8192], start: int[64]) -> str[8192]:
    out: str[8192] = ""
    tbl: str[256] = ""
#<<TBL>>
    tbl[1] = 1
    tbl[2] = 2
    tbl[3] = 3
    tbl[4] = 4
    tbl[5] = 5
    tbl[6] = 6
    tbl[7] = 7
    tbl[8] = 8
    tbl[9] = 9
    tbl[10] = 10
    tbl[11] = 11
