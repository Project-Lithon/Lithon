# 4.11. `for i in range(...)` ASSIGNS a variable the program already declared
# (V1_SPEC 0.6.6): it never creates one, and a loop target keeps the width it
# was declared with. A narrow counter's bounds must be provable inside its
# width (a literal that fits, or an int variable no wider than the counter);
# an int[64] counter takes any bounds and any step.
#
# A loop target ends on the LAST value it produced, and a loop that never runs
# leaves it untouched -- both exactly as CPython does. Assigning to a live
# target inside its body is refused, because it would change the iteration count.
#
# The expected output is CPython's answer for the same program (with
# `from __future__ import annotations` so `int[8]` needs no `typing` import).


def sum_to(n: int[64]) -> int[64]:
    k: int[64] = 0
    total: int[64] = 0
    for k in range(n):
        total = total + k
    return total


# A narrow counter with a literal bound.
a: int[8] = 100
for a in range(5):
    print(a)

# A narrow counter bounded by a variable that is no wider than it.
m: int[8] = 3
b: int[8] = 0
for b in range(m):
    print(b)

# A 16-bit counter, two-argument form.
c: int[16] = 0
for c in range(250, 253):
    print(c)

# An int[64] counter takes a stepped range, upward and downward.
d: int[64] = 0
for d in range(1, 10, 4):
    print(d)
for d in range(9, 0, -4):
    print(d)

# A loop that never runs prints nothing.
for d in range(0):
    print(d)

# Nested loops over two declared counters, and a counter reused afterwards.
i: int[64] = 0
j: int[64] = 0
t: int[64] = 0
for i in range(3):
    for j in range(3):
        t = t + i * j
print(t)
for i in range(2):
    print(i)

# A declared counter inside a function.
print(sum_to(10))

# The counter ends on the last value produced, not on the limit.
print(a)
print(b)
print(c)
print(d)
print(i)

# A loop that never runs leaves the counter exactly as it was.
z: int[64] = 77
for z in range(0):
    print(1)
print(z)
y: int[8] = 5
for y in range(7, 7):
    print(1)
print(y)
w: int[64] = 31
for w in range(10, 1):
    print(1)
print(w)

# break leaves the counter on the value it broke at.
q: int[64] = 0
for q in range(100):
    if q == 4:
        break
print(q)

# enumerate and zip assign declared targets the same way: the index is a
# counter (here a narrow int[8]), the elements keep the container's type, and
# every target ends on its last value.
xs: list[int[64], 3] = [10, 20, 30]
ys: list[int[64], 2] = [1, 2]
ei: int[8] = 0
ex: int[64] = 0
for ei, ex in enumerate(xs):
    print(ei)
    print(ex)
print(ei)
print(ex)
za: int[64] = 0
zb: int[64] = 0
for za, zb in zip(xs, ys):
    print(za + zb)
print(za)
print(zb)
