# 4.1 (phase 3). Nested containers. A list/tuple of list/tuple is ONE flat,
# row-major run of scalar leaves; an access carries the whole index chain and
# lands on a leaf, and the whole aggregate renders exactly as Python's repr.
# Every line must match byte-for-byte across the interpreter and the JIT.
grid: list[list[int[64], 3], 2] = [[1, 2, 3], [4, 5, 6]]
print(grid)
print(grid[1][2])
grid[0][0] = 100
print(grid)

narrow: list[list[int[32], 2], 2] = [[-1, -2], [-3, -4]]
print(narrow)
print(narrow[1][0])

flags: list[tuple[bool, 2], 2] = [(True, False), (False, True)]
print(flags)

pair: tuple[list[float[64], 2], 2] = ([1.5, 2.5], [3.5, 4.5])
print(pair)
print(pair[0][1])

deep: list[list[list[int[64], 2], 2], 2] = [[[1, 2], [3, 4]], [[5, 6], [7, 8]]]
print(deep)
print(deep[1][0][1])
print(len(deep))
print(len(grid))
