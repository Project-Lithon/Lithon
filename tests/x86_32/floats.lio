def hyp2(a: float[64], b: float[64]) -> float[64]:
    return a * a + b * b


def half(n: int[64]) -> float[64]:
    return n / 2


def avg(a: float[64], b: float[64], c: float[64]) -> float[64]:
    return (a + b + c) / 3.0


x: float[64] = 1.5
y: float[64] = 2.25
print(x + y)
print(x - y)
print(x * y)
print(x / y)
print(x % y)
print(-7.5 % 2.0)
print(hyp2(3.0, 4.0))
print(half(7))
print(avg(1.0, 2.0, 4.0))
print(1 / 3)
print(10 / 4)
n: int[64] = 3
print(x * n)
print(n + y)
print(0.1 + 0.2)
print(1e300 * 1e10)
print(x < y)
print(x > y)
print(x == 1.5)
print(x != 1.5)
print(n < y)
print(n == 3.0)
inf: float[64] = 1e300 * 1e10
nan: float[64] = inf - inf
print(nan == nan)
print(nan != nan)
print(nan < 1.0)
print(nan > 1.0)
print(inf > 1e308)
print(nan)
print(inf)
print(-inf)
m: int[32] = 7
print(float(64, m))
print(int(64, x * 4.0))
print(int(64, -2.9))
f: float[64] = 0.0
i: int[64] = 0
while i < 10:
    f = f + 0.1
    i = i + 1
print(f)
print(x < 1.5)
print(x > 1.5)
print(x < x)
print(x > x)
print(n < 3.0)
print(n > 3.0)
print(0.0 < -0.0)
print(0.0 > -0.0)
