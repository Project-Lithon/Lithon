x: int[64] = -5
y: int[64] = 3
big: int[64] = 4294967296
print(x < y)
print(x > y)
print(x == y)
print(x != y)
print(big > 4294967295)
print(big < 4294967297)
print(-big < -4294967295)
print(big == 4294967296)
print(big != 4294967296)
print(x & 255)
print(x | 256)
print(x ^ -1)
print(big << 3)
print(big >> 2)
print(x >> 1)
print(x << 62)
print(1 << 63 - 1)
print(x and y)
print(0 and y)
print(x or y)
print(0 or y)
print(not x)
print(not 0)
n: int[64] = 40
print(1 << n)
print(-1 >> n)
